+    def _apply_gripper_recovery(self, env_idx: int, proprio: np.ndarray, actions: np.ndarray) -> np.ndarray:
+        """Missed-grasp recovery: if a gripper has been closed on nothing for `gripper_recovery_patience`
+        consecutive replans while the new plan still keeps it closed, open it for this chunk so the policy can
+        re-attempt the grasp. Adapted from the 2025 1st-place solution's gripper correction rules."""
+        if self.empty_closed_count is None or self.empty_closed_count.shape[0] != self.batch_size:
+            self.empty_closed_count = np.zeros((self.batch_size, 2), dtype=np.int32)
+        eef_proprio = [c for c in self.robot.proprio if c.is_eef]
+        eef_action = [c for c in self.robot.action if c.is_eef]
+        executed = actions[: self.action_horizon]
+        for g, (prop_cfg, act_cfg) in enumerate(zip(eef_proprio, eef_action, strict=True)):
+            width = float(np.sum(proprio[prop_cfg.indices]))
+            commanded_closed = float(np.mean(executed[:, act_cfg.indices])) < GRIPPER_CLOSE_CMD
+            if width < EMPTY_GRIPPER_WIDTH and commanded_closed:
+                self.empty_closed_count[env_idx, g] += 1
+            else:
+                self.empty_closed_count[env_idx, g] = 0
+            if self.empty_closed_count[env_idx, g] >= self.gripper_recovery_patience:
+                logger.info(
+                    "Gripper recovery: env %d %s closed on nothing (width %.4f) for %d replans -> opening",
+                    env_idx, act_cfg.name, width, self.empty_closed_count[env_idx, g],
+                )
+                actions = actions.copy()
+                actions[:, act_cfg.indices] = 1.0
+                self.empty_closed_count[env_idx, g] = 0
+        return actions
