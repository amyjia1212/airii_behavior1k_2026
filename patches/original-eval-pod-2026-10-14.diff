+    def _update_gripper_recovery(self, state: np.ndarray) -> None:
+        """Track how long each gripper has been stuck and start a forced open once it exceeds the limit.
+
+        Called once per real observation; with client-side chunk replay that is every `execute_in_n_steps` env
+        steps, so the counter advances by the number of actions executed since the previous observation.
+        """
+        elapsed, self._steps_since_obs = self._steps_since_obs, 0
+        if self.config.gripper_recovery_steps <= 0:
+            return
+        for idx, name in GRIPPER_NAMES.items():
+            width = float(state[idx])
+            prev_width, self._gripper_prev_width[idx] = self._gripper_prev_width[idx], width
+            if self._gripper_force_open[idx] > 0:  # still opening from the last recovery
+                continue
+            cmd = self._gripper_last_cmd[idx]
+            fully_closed = width < CLOSED_THRESHOLD
+            blocked = (
+                cmd is not None
+                and prev_width is not None
+                and cmd - width > BLOCKED_CMD_GAP
+                and width < OPEN_THRESHOLD
+                and abs(width - prev_width) < BLOCKED_MOVE_EPS
+            )
+            if not (fully_closed or blocked):
+                self._gripper_stuck_steps[idx] = 0
+                self._gripper_was_stuck[idx] = False
+                continue
+            if self._gripper_was_stuck[idx]:
+                self._gripper_stuck_steps[idx] += elapsed
+            self._gripper_was_stuck[idx] = True
